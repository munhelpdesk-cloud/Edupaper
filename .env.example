# Connect the app to your EduPaper admin panel's Supabase project (Settings > API).
# Use the PUBLIC "anon" key only. Never put the service_role key in the app.
# Leave both empty to run on the built-in sample syllabus and questions.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: your own server that generates questions with AI (see src/ai.js).
VITE_AI_URL=
